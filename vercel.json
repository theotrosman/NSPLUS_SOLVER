{
  "cleanUrls": true,
  "functions": {
    "api/generate.js": {
      "maxDuration": 120
    },
    "api/uml.js": {
      "maxDuration": 120
    },
    "api/pc.js": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Author", "value": "Theo Trosman - https://github.com/theotrosman" }
      ]
    }
  ]
}
